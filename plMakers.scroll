title The Language Makers Homepages
description Flip through the personal homepages of programming language creators, ranked by their top PLDB language.
baseUrl https://breck.lol/
permalink plMakers.html
openGraphImage plMakers.jpg
buildHtml
buildConcepts makersData.js makersData.json
 sortBy topRank
metaTags

html
 <div class="appShell">
  <aside class="sidebar" aria-label="Programming language creators">
   <div class="sidebarLabel">Makers</div>
   <nav class="makerList" id="makerList"></nav>
  </aside>
  <main class="mainPane">
   <header class="masthead">
    <div>
     <h1>The Language Makers<br><span>Homepages</span></h1>
     <p>The quirky personal homepages of programming language creators</p>
     <p class="credit">Made by <a href="https://twitter.com/breckyunits" target="_blank" rel="noopener noreferrer">Breck Yunits</a> using data from <a href="http://pldb.info/lists/creators" target="_blank" rel="noopener noreferrer">PLDB</a></p>
    </div>
    <a class="repoLink" href="https://github.com/breck7/breck.lol/blob/main/plMakers.scroll" target="_blank" rel="noopener noreferrer" aria-label="Open plMakers.scroll on GitHub" title="plMakers.scroll on GitHub">
     <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.4-2.71 5.38-5.29 5.67.42.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
    </a>
   </header>
   <section class="stage" id="stage" aria-roledescription="carousel" aria-label="Creator homepages" tabindex="0">
    <div class="atmosphere" aria-hidden="true"></div>
    <div class="carousel" id="carousel"></div>
    <button class="previewCenterTarget previewPrevious" id="previousPreview" type="button" aria-label="Center previous creator"></button>
    <button class="previewCenterTarget previewNext" id="nextPreview" type="button" aria-label="Center next creator"></button>
    <button class="navButton previous" id="previous" type="button" aria-label="Previous creator" title="Previous creator (Left arrow)"><span>‹</span></button>
    <button class="navButton next" id="next" type="button" aria-label="Next creator" title="Next creator (Right arrow)"><span>›</span></button>
    <div class="position" aria-hidden="true"><span id="positionCurrent">01</span><i></i><span id="positionTotal"></span></div>
   </section>
  </main>
 </div>
 <div class="srOnly" id="liveRegion" aria-live="polite"></div>

css
 :root {
  color-scheme: dark;
  --ink: #edf6f2;
  --muted: #8ba39d;
  --acid: #b9f228;
  --orange: #ff7657;
  --panel: rgba(12, 24, 27, .82);
  --line: rgba(205, 244, 234, .13);
  --sidebar: 244px;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
 }
 * { box-sizing: border-box; }
 html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #061012; }
 body {
  color: var(--ink);
  background:
   radial-gradient(circle at 72% 28%, rgba(30, 101, 92, .28), transparent 34%),
   radial-gradient(circle at 42% 105%, rgba(185, 242, 40, .09), transparent 35%),
   #061012;
 }
 button, a { font: inherit; }
 .appShell { display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr); width: 100%; height: 100%; }
 .sidebar {
  position: relative;
  z-index: 20;
  min-width: 0;
  padding: 18px 0;
  overflow: hidden;
  border-right: 1px solid rgba(255,255,255,.13);
  background:
   linear-gradient(135deg, rgba(255,255,255,.055), transparent 36%),
   rgba(8, 20, 22, .76);
  box-shadow: 18px 0 60px rgba(0,0,0,.24);
  backdrop-filter: blur(28px) saturate(135%);
 }
 .sidebarLabel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 3px 18px 12px;
  color: #a9bbb6;
  font-size: 10px;
  font-weight: 720;
  letter-spacing: .16em;
  text-transform: uppercase;
 }
 .makerList {
  height: calc(100% - 28px);
  overflow: auto;
  padding: 2px 10px 60px;
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.16) transparent;
  mask-image: linear-gradient(to bottom, transparent 0, black 13px, black calc(100% - 24px), transparent 100%);
 }
 .makerList a {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  width: 100%;
  min-height: 45px;
  padding: 7px 10px;
  border: 0;
  border-radius: 8px;
  color: #80938e;
  background: transparent;
  text-decoration: none;
  text-align: left;
  cursor: pointer;
  transition: color .16s ease, background .16s ease, transform .16s ease;
 }
 .makerList a:hover { color: #dbe8e4; background: rgba(255,255,255,.055); transform: translateX(2px); }
 .makerList a[aria-current="true"] {
  color: #f4faf7;
  background: linear-gradient(90deg, rgba(185,242,40,.18), rgba(185,242,40,.065));
  box-shadow: inset 2px 0 var(--acid);
 }
 .tocCopy { display: grid; min-width: 0; gap: 3px; }
 .tocRank { align-self: start; margin-top: 2px; color: #526762; font: 600 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace; font-variant-numeric: tabular-nums; }
 .makerList a[aria-current="true"] .tocRank { color: var(--acid); }
 .tocName { overflow: hidden; font-size: 12px; font-weight: 560; letter-spacing: -.01em; text-overflow: ellipsis; white-space: nowrap; }
 .tocLanguage { overflow: hidden; color: #566d67; font-size: 9px; font-weight: 600; letter-spacing: .02em; text-overflow: ellipsis; white-space: nowrap; }
 .makerList a[aria-current="true"] .tocLanguage { color: #9fba57; }
 .mainPane { min-width: 0; display: grid; grid-template-rows: auto minmax(0, 1fr); }
 .masthead {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: clamp(24px, 4.1vh, 50px) clamp(28px, 4.5vw, 72px) 4px;
 }
 h1 { margin: 0; font-size: clamp(30px, 4.3vw, 68px); font-weight: 730; line-height: .86; letter-spacing: -.065em; }
 h1 span { color: transparent; -webkit-text-stroke: 1px rgba(237,246,242,.56); }
 .masthead p { max-width: 530px; margin: 16px 0 0; color: var(--muted); font-size: clamp(11px, 1.15vw, 15px); line-height: 1.45; letter-spacing: .01em; }
 .masthead .credit { margin-top: 7px; color: #5e746e; font-size: clamp(9px, .85vw, 11px); }
 .credit a { color: #9eb2ac; text-decoration: none; border-bottom: 1px solid rgba(185,242,40,.32); transition: color .18s ease, border-color .18s ease; }
 .credit a:hover { color: var(--acid); border-color: var(--acid); }
 .repoLink {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: var(--ink);
  background: rgba(255,255,255,.035);
  transition: transform .2s ease, color .2s ease, border-color .2s ease, background .2s ease;
 }
 .repoLink:hover { color: #071012; border-color: var(--acid); background: var(--acid); transform: translateY(-2px) rotate(-4deg); }
 .repoLink svg { width: 20px; fill: currentColor; }
 .stage {
  position: relative;
  min-height: 0;
  overflow: hidden;
  perspective: 1500px;
  perspective-origin: 50% 43%;
  outline: none;
  touch-action: pan-y;
 }
 .stage:focus-visible { box-shadow: inset 0 0 0 1px rgba(185,242,40,.5); }
 .atmosphere {
  position: absolute;
  inset: 0;
  overflow: hidden;
 }
 .atmosphere::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -36%;
  width: 125%;
  height: 82%;
  transform: translateX(-50%) perspective(700px) rotateX(67deg);
  transform-origin: center bottom;
  opacity: .23;
  background-image:
   linear-gradient(rgba(161,221,204,.15) 1px, transparent 1px),
   linear-gradient(90deg, rgba(161,221,204,.15) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: linear-gradient(to top, black, transparent 76%);
 }
 .atmosphere::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 44%;
  width: min(76vw, 980px);
  height: 220px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: rgba(79, 219, 183, .13);
  filter: blur(80px);
 }
 .carousel { position: absolute; inset: 0; transform-style: preserve-3d; }
 .card {
  --x: 0px;
  --z: 0px;
  --rot: 0deg;
  --scale: 1;
  --hover: 1;
  position: absolute;
  left: 50%;
  top: 43%;
  width: clamp(360px, 58vw, 900px);
  height: clamp(330px, 59vh, 650px);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.22);
  border-radius: clamp(13px, 1.6vw, 21px);
  background: #d7e0dd;
  box-shadow: 0 45px 100px rgba(0,0,0,.54), 0 12px 28px rgba(0,0,0,.34), inset 0 1px rgba(255,255,255,.55);
  transform: translate(-50%, -50%) translate3d(var(--x), 0, var(--z)) rotateY(var(--rot)) scale(calc(var(--scale) * var(--hover)));
  transform-style: preserve-3d;
  transition: transform .42s cubic-bezier(.2,.78,.18,1), opacity .3s ease, filter .24s ease, box-shadow .24s ease;
  will-change: transform;
 }
 .card:not(.active):hover, .card.sideHovered { --hover: 1.13; filter: saturate(1.12) brightness(1.06); box-shadow: 0 55px 115px rgba(0,0,0,.64), 0 0 0 1px rgba(185,242,40,.42); }
 .card.active { border-color: rgba(255,255,255,.34); }
 .browserBar {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 8px;
  height: 42px;
  padding: 0 14px;
  color: #d9e6e1;
  background: linear-gradient(#233439, #15262a);
  border-bottom: 1px solid rgba(0,0,0,.38);
 }
 .makerName { flex: 0 1 auto; min-width: 0; max-width: 38%; overflow: hidden; color: inherit; font-size: 12px; font-weight: 650; letter-spacing: -.01em; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
 .makerName:hover { text-decoration: underline; text-underline-offset: 3px; }
 .barLanguages { display: flex; flex: 1; min-width: 0; gap: 4px; overflow: hidden; }
 .viewport { position: absolute; inset: 42px 0 0; overflow: hidden; background: #cfd8d5; }
 .placeholder {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  color: #38504a;
  background:
   linear-gradient(135deg, rgba(255,255,255,.9), rgba(210,225,219,.74)),
   repeating-linear-gradient(90deg, transparent 0 31px, rgba(46,79,70,.05) 32px);
 }
 .initials { font-size: clamp(52px, 8vw, 124px); font-weight: 780; letter-spacing: -.09em; opacity: .14; }
 .domain { position: absolute; bottom: 28px; max-width: 80%; overflow: hidden; font: 600 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace; text-overflow: ellipsis; white-space: nowrap; opacity: .55; }
 iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: white; }
 .card:not(.active) iframe { pointer-events: none; }
 .cardTint { position: absolute; inset: 0; z-index: 2; pointer-events: none; box-shadow: inset 0 0 70px rgba(3,14,16,.09); }
 .language {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  max-width: 100%;
  padding: 4px 7px;
  overflow: hidden;
  border: 1px solid rgba(205,244,234,.16);
  border-radius: 999px;
  color: #dce8e4;
  background: rgba(255,255,255,.06);
  font-size: 8px;
  font-weight: 620;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
 }
 .language:first-child { color: #172109; border-color: var(--acid); background: var(--acid); }
 .language b { font: 750 8px/1 ui-monospace, SFMono-Regular, Menlo, monospace; opacity: .7; }
 .previewCenterTarget { position: absolute; z-index: 11; top: 43%; width: max(0px, calc((100% - clamp(360px, 58vw, 900px)) / 2)); height: clamp(330px, 59vh, 650px); padding: 0; border: 0; background: transparent; cursor: pointer; transform: translateY(-50%); }
 .previewCenterTarget:focus-visible { outline: 2px solid var(--acid); outline-offset: -3px; }
 .previewCenterTarget:disabled { pointer-events: none; }
 .previewPrevious { left: 0; }
 .previewNext { right: 0; }
 .navButton {
  position: absolute;
  z-index: 12;
  top: 43%;
  display: grid;
  place-items: center;
  width: 50px;
  height: 50px;
  padding: 0;
  border: 1px solid rgba(255,255,255,.17);
  border-radius: 50%;
  color: #dce9e5;
  background: rgba(7,19,21,.72);
  box-shadow: 0 10px 28px rgba(0,0,0,.24);
  cursor: pointer;
  transform: translateY(-50%);
  backdrop-filter: blur(12px);
  transition: color .18s ease, background .18s ease, border-color .18s ease, transform .18s ease, opacity .18s ease;
 }
 .navButton span { margin-top: -4px; font-size: 38px; font-weight: 220; line-height: 1; }
 .navButton:hover { color: #081012; border-color: var(--acid); background: var(--acid); transform: translateY(-50%) scale(1.08); }
 .navButton:disabled { opacity: .18; cursor: default; pointer-events: none; }
 .previous { left: clamp(15px, 2.5vw, 40px); }
 .next { right: clamp(15px, 2.5vw, 40px); }
 .position {
  position: absolute;
  z-index: 10;
  left: 50%;
  bottom: clamp(15px, 2.8vh, 30px);
  display: flex;
  align-items: center;
  gap: 9px;
  color: #60746f;
  font: 650 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  transform: translateX(-50%);
 }
 .position i { display: block; width: 48px; height: 1px; background: linear-gradient(90deg, var(--acid), rgba(185,242,40,.15)); }
 .position span:first-child { color: #d6e3df; }
 .srOnly { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
 @media (max-width: 900px) {
  :root { --sidebar: 202px; }
  .masthead { padding-left: 28px; padding-right: 28px; }
  .card { width: clamp(330px, 66vw, 720px); }
  .previewCenterTarget { width: max(0px, calc((100% - clamp(330px, 66vw, 720px)) / 2)); }
  .tocName { font-size: 11px; }
 }
 @media (max-width: 680px) {
  html, body { overflow-x: hidden; overflow-y: auto; }
  .appShell { grid-template-columns: 1fr; grid-template-rows: 98px minmax(650px, calc(100vh - 98px)); min-height: 748px; }
  .sidebar { display: grid; grid-template-rows: 24px 1fr; padding: 10px 0 7px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.13); }
  .sidebarLabel { grid-row: 1; padding: 1px 14px 0; }
  .makerList { grid-column: 1 / -1; display: flex; gap: 4px; width: 100%; height: 55px; padding: 6px 10px 9px; overflow-x: auto; overflow-y: hidden; mask-image: linear-gradient(90deg, transparent, black 12px, black calc(100% - 12px), transparent); }
  .makerList a { flex: 0 0 auto; display: block; width: auto; min-height: 34px; padding: 6px 11px; white-space: nowrap; }
  .makerList a[aria-current="true"] { box-shadow: inset 0 -2px var(--acid); }
  .tocRank { display: none; }
  .tocName { font-size: 10px; }
  .mainPane { min-height: 650px; }
  .masthead { padding: 25px 20px 0; }
  h1 { font-size: clamp(31px, 10.5vw, 48px); }
  .masthead p { max-width: 310px; margin-top: 11px; font-size: 10px; }
  .masthead .credit { margin-top: 5px; font-size: 8px; }
  .repoLink { width: 38px; height: 38px; }
  .card { top: 42%; width: min(86vw, 540px); height: min(53vh, 500px); }
  .previewCenterTarget { top: 42%; width: max(0px, calc((100% - min(86vw, 540px)) / 2)); height: min(53vh, 500px); }
  .navButton { top: 42%; width: 42px; height: 42px; }
  .previous { left: 8px; }
  .next { right: 8px; }
 }
 @media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .001ms !important; animation-duration: .001ms !important; }
 }

makersData.js

script
 (() => {
  "use strict"
  const parseLanguage = entry => {
   const match = entry.match(/^(.*) #(\d+)$/)
   return {name: match[1], rank: Number(match[2])}
  }
  const makers = makersData.map(maker => ({
   name: maker.id,
   homepage: maker.homepage,
   languages: [
    {name: maker.topLanguage, rank: maker.topRank},
    ...(maker.otherLanguages ? maker.otherLanguages.split(" | ").map(parseLanguage) : [])
   ]
  }))
  const list = document.getElementById("makerList")
  const carousel = document.getElementById("carousel")
  const previous = document.getElementById("previous")
  const next = document.getElementById("next")
  const previousPreview = document.getElementById("previousPreview")
  const nextPreview = document.getElementById("nextPreview")
  const positionCurrent = document.getElementById("positionCurrent")
  const positionTotal = document.getElementById("positionTotal")
  const liveRegion = document.getElementById("liveRegion")
  const stage = document.getElementById("stage")
  const visibleCards = new Map()
  let current = 0
  let wheelLocked = false
  let pointerStart = null
  const escapeHtml = value => String(value).replace(/[&<>"']/g, character => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"})[character])
  const pad = value => String(value).padStart(2, "0")
  const initials = name => name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join("")
  const domain = homepage => {
   try { return new URL(homepage).hostname.replace(/^www\./, "") }
   catch { return homepage }
  }
  const cardPosition = distance => {
   const direction = Math.sign(distance)
   const depth = Math.abs(distance)
   const settings = [
    ["0px", "0px", "0deg", 1, 1],
    [`calc(${direction} * clamp(225px, 25vw, 400px))`, "-135px", `${direction * -38}deg`, .82, .9],
    [`calc(${direction} * clamp(320px, 34vw, 545px))`, "-285px", `${direction * -52}deg`, .64, .6],
    [`calc(${direction} * clamp(385px, 41vw, 660px))`, "-430px", `${direction * -60}deg`, .5, .28]
   ]
   return settings[Math.min(depth, 3)]
  }
  const createCard = index => {
   const maker = makers[index]
   const card = document.createElement("article")
   const languageHtml = maker.languages.map((language, languageIndex) => `<span class="language">${escapeHtml(language.name)}${languageIndex === 0 ? `<b>#${language.rank}</b>` : ""}</span>`).join("")
   card.className = "card"
   card.dataset.index = index
   card.innerHTML = `
    <div class="browserBar"><a class="makerName" href="${escapeHtml(maker.homepage)}" target="_blank" rel="noopener noreferrer">${escapeHtml(maker.name)}</a><div class="barLanguages">${languageHtml}</div></div>
    <div class="viewport">
     <div class="placeholder"><span class="initials">${escapeHtml(initials(maker.name))}</span><span class="domain">${escapeHtml(domain(maker.homepage))}</span></div>
     <iframe src="${escapeHtml(maker.homepage)}" loading="eager" tabindex="-1" title="${escapeHtml(maker.name)} homepage preview"></iframe>
     <div class="cardTint"></div>
    </div>`
   carousel.appendChild(card)
   visibleCards.set(index, card)
   return card
  }
  const renderCards = () => {
   const wanted = new Set()
   for (let index = Math.max(0, current - 3); index <= Math.min(makers.length - 1, current + 3); index++) wanted.add(index)
   visibleCards.forEach((card, index) => {
    if (!wanted.has(index)) {
     card.remove()
     visibleCards.delete(index)
    }
   })
   wanted.forEach(index => {
    const card = visibleCards.get(index) || createCard(index)
    const distance = index - current
    const [x, z, rotation, scale, opacity] = cardPosition(distance)
    card.style.setProperty("--x", x)
    card.style.setProperty("--z", z)
    card.style.setProperty("--rot", rotation)
    card.style.setProperty("--scale", scale)
    card.style.opacity = opacity
    card.style.zIndex = String(10 - Math.abs(distance))
    card.classList.remove("sideHovered")
    card.classList.toggle("active", distance === 0)
    const iframe = card.querySelector("iframe")
    iframe.tabIndex = distance === 0 ? 0 : -1
    iframe.setAttribute("aria-hidden", distance === 0 ? "false" : "true")
   })
  }
  const updatePreviewTargets = () => {
   previousPreview.disabled = current === 0
   nextPreview.disabled = current === makers.length - 1
   previousPreview.setAttribute("aria-label", current > 0 ? `Center ${makers[current - 1].name}` : "No previous creator")
   nextPreview.setAttribute("aria-label", current < makers.length - 1 ? `Center ${makers[current + 1].name}` : "No next creator")
  }
  const setPreviewHover = (index, hovered) => visibleCards.get(index)?.classList.toggle("sideHovered", hovered)
  const updateList = shouldScroll => {
   const links = list.querySelectorAll("a[data-index]")
   links.forEach((link, index) => link.setAttribute("aria-current", index === current ? "true" : "false"))
   if (shouldScroll) {
    const link = links[current]
    const mobile = matchMedia("(max-width: 680px)").matches
    list.scrollTo(mobile
     ? {left: link.offsetLeft - list.clientWidth / 2 + link.offsetWidth / 2, behavior: "smooth"}
     : {top: link.offsetTop - list.clientHeight / 2 + link.offsetHeight / 2, behavior: "smooth"})
   }
  }
  const select = (index, shouldScroll = true) => {
   const nextIndex = Math.max(0, Math.min(makers.length - 1, index))
   if (nextIndex === current && visibleCards.size) return
   current = nextIndex
   renderCards()
   updateList(shouldScroll)
   previous.disabled = current === 0
   next.disabled = current === makers.length - 1
   updatePreviewTargets()
   positionCurrent.textContent = pad(current + 1)
   const maker = makers[current]
   liveRegion.textContent = `${maker.name}, ${maker.languages[0].name}, rank ${maker.languages[0].rank}`
   history.replaceState(null, "", `#${encodeURIComponent(maker.name)}`)
  }
  list.innerHTML = makers.map((maker, index) => `<a href="${escapeHtml(maker.homepage)}" data-index="${index}" aria-current="${index === 0}"><span class="tocCopy"><span class="tocName">${escapeHtml(maker.name)}</span><span class="tocLanguage">${escapeHtml(maker.languages[0].name)}</span></span><span class="tocRank">#${maker.languages[0].rank}</span></a>`).join("")
  positionTotal.textContent = pad(makers.length)
  list.addEventListener("click", event => {
   const link = event.target.closest("a[data-index]")
   if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
   event.preventDefault()
   select(Number(link.dataset.index))
  })
  previous.addEventListener("click", () => select(current - 1))
  next.addEventListener("click", () => select(current + 1))
  previousPreview.addEventListener("click", () => select(current - 1))
  nextPreview.addEventListener("click", () => select(current + 1))
  previousPreview.addEventListener("pointerenter", () => setPreviewHover(current - 1, true))
  previousPreview.addEventListener("pointerleave", () => setPreviewHover(current - 1, false))
  nextPreview.addEventListener("pointerenter", () => setPreviewHover(current + 1, true))
  nextPreview.addEventListener("pointerleave", () => setPreviewHover(current + 1, false))
  document.addEventListener("keydown", event => {
   if (event.key === "ArrowLeft") { event.preventDefault(); select(current - 1) }
   if (event.key === "ArrowRight") { event.preventDefault(); select(current + 1) }
   if (event.key === "Home") { event.preventDefault(); select(0) }
   if (event.key === "End") { event.preventDefault(); select(makers.length - 1) }
  })
  stage.addEventListener("wheel", event => {
   if (wheelLocked || Math.max(Math.abs(event.deltaX), Math.abs(event.deltaY)) < 18) return
   wheelLocked = true
   select(current + (event.deltaX + event.deltaY > 0 ? 1 : -1))
   window.setTimeout(() => { wheelLocked = false }, 280)
  }, {passive: true})
  stage.addEventListener("pointerdown", event => { pointerStart = event.clientX })
  stage.addEventListener("pointerup", event => {
   if (pointerStart === null) return
   const distance = event.clientX - pointerStart
   pointerStart = null
   if (Math.abs(distance) > 55) select(current + (distance < 0 ? 1 : -1))
  })
  window.addEventListener("hashchange", () => {
   const name = decodeURIComponent(location.hash.slice(1))
   const index = makers.findIndex(maker => maker.name === name)
   if (index >= 0) select(index)
  })
  const hashName = decodeURIComponent(location.hash.slice(1))
  const hashIndex = makers.findIndex(maker => maker.name === hashName)
  current = hashIndex >= 0 ? hashIndex : 0
  renderCards()
  updateList(true)
  previous.disabled = current === 0
  next.disabled = current === makers.length - 1
  updatePreviewTargets()
  positionCurrent.textContent = pad(current + 1)
 })()

// ScrollSet schema. One creator per record, ordered by top PLDB language rank.
// Source: http://pldb.info/creators/creators.json
